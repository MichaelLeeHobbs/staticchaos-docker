# OSX
# =========================

.DS_Store
.AppleDouble
.LSOverride

# Thumbnails
._*

# Files that might appear in the root of a volume
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns

# Directories potentially created on remote AFP share
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# =========================
# Runtime game data — mutable, seeded into Docker named volumes on first run.
# NEVER commit: this fork stores player passwords in PLAINTEXT (see
# README.docker.md), so real player files would leak credentials. Empty dirs
# are kept via .gitkeep so the build/volume mount still works.
# =========================
/player/*
!/player/s/
/player/s/*
!/player/s/.gitkeep
/notes/*
!/notes/.gitkeep
/finger/*
!/finger/.gitkeep
/log/

# Editor / source backups (clutter, not loaded by the game)
*.bak
*.old

# Personal deploy scripts — copy the *.example.sh templates and edit for your host
/deploy.sh
/mud-redeploy.sh
/web/deploy-web.sh
/backup-volumes.sh
/watchdog.sh
/tmp/

# Volume backups (if ever placed in-tree; the real backups live outside the repo)
/backups/
/area-backups/

# Claude Code agent config / skills / transient worktrees — local only
/.claude/
/mud-deploy-image.sh

# Generated world data (build outputs, regenerated by build:data / build:pdf) (#65)
/world-maps/*
!/world-maps/.gitkeep

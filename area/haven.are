endif
~
>speech_prog marry kiss date cute hot single~
if rand(33)
mpecho $I says 'I've outlived three spouses and a continent. Try someone with a shorter memory.'
else
if rand(50)
mpecho $I says 'Charming. The last person who flirted with me also tried to rob me. Funny coincidence.'
else
mpecho $I says 'No. But I admire the confidence of a person actively on fire asking me out.'
endif
endif
~
>speech_prog kill fight attack die murder destroy~
if rand(33)
mpecho $I says 'Threaten me? I'm not even the scary thing in this room, and I'm definitely scarier than you.'
else
if rand(50)
mpecho $I says 'Go ahead. The guards are bored, the gods are watching, and I'm insured.'
else
mpecho $I says 'You want a fight? The whole realm is a fight. Walk twenty feet, it'll find you.'
endif
endif
~

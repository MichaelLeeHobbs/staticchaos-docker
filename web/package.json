{
  "name": "staticchaos-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Static companion site for the Static Chaos MUD (docs, world map, data browser, GMCP files).",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "sync": "node scripts/sync-content.mjs",
    "dev": "node scripts/sync-content.mjs && vite",
    "build": "node scripts/sync-content.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "serve": "node server.mjs",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "9.4.0",
    "@mui/material": "9.4.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "d3": "7.9.0",
    "mermaid": "11.17.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.18.3",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@types/d3": "7.4.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
